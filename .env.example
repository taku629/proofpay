# PayPal Developer Dashboard > Sandbox app. The local simulation works without these values.
# If enabled later, use Sandbox credentials only. Never use a Live credential.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional server-only HMAC secret for signed, short-lived payment-flow tokens.
# If blank, the Sandbox client secret is used; local simulation uses an app-local fallback.
PROOFPAY_SIGNING_SECRET=

# Optional Gemini API Free-tier demo (fixed model: gemini-2.5-flash).
# Do not fill these until the operator independently verifies that this Google AI Studio
# project is eligible for the Gemini API Free tier and has no billing/payment account attached.
# Keep the API key server-only: never rename this to a NEXT_PUBLIC_* variable.
GEMINI_API_KEY=
# Required provenance value for the project used by the operator; never sent to the browser or model.
GEMINI_PROJECT_ID=
# Set to exactly "true" only after the free-tier and no-billing prerequisites above are confirmed.
GEMINI_FREE_TIER_CONFIRMED=false
