# PayPal Developer Dashboard > Sandbox app. Use a Sandbox app only.
# Set the same Sandbox client ID in both variables. Never use a Live credential.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional server-only HMAC secret for signed, short-lived payment-flow tokens.
# If blank, the Sandbox client secret is used; local simulation uses an app-local fallback.
PROOFPAY_SIGNING_SECRET=

# Any already-owned, eligible free-tier OpenAI-compatible provider (e.g. AMD or Nebius).
# Keep provider credentials server-side; do not use NEXT_PUBLIC_ for these values.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
