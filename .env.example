# PayPal Developer Dashboard > Sandbox app. This project currently runs in local simulation mode without these values.
# If enabled later, use Sandbox credentials only. Never use a Live credential.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional server-only HMAC secret for signed, short-lived payment-flow tokens.
# If blank, the Sandbox client secret is used; local simulation uses an app-local fallback.
PROOFPAY_SIGNING_SECRET=
